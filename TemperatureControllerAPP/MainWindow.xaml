<Window x:Class="TemperatureControllerAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TemperatureControllerAPP.Converters"
        Title="NT Series 溫控器 — Modbus RTU / TCP"
        MinWidth="1280"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        FontFamily="Segoe UI"
        FontSize="13"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="StatusLamp" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stroke" Value="#8A939E"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="#C9D1D9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ParamDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EBF0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Row 1: Connection (RTU / TCP) -->
        <GroupBox Grid.Row="0" Header="Modbus 連線設定（RTU / TCP）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Device profiles -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="裝置設定檔" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.75"/>
                    <ComboBox x:Name="CmbProfiles" Grid.Column="1" Margin="0,0,8,0"
                              DisplayMemberPath="ProfileName" SelectionChanged="Profiles_SelectionChanged"/>
                    <TextBlock Grid.Column="2" Text="名稱" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.75"/>
                    <TextBox x:Name="TxtProfileName" Grid.Column="3" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Content="套用" Padding="10,4" Margin="0,0,4,0" Click="ApplyProfile_Click"/>
                    <Button Grid.Column="5" Content="儲存設定檔" Padding="10,4" Margin="0,0,4,0" Click="SaveProfile_Click"/>
                    <Button Grid.Column="6" Content="另存" Padding="10,4" Margin="0,0,4,0" Click="SaveProfileAs_Click"/>
                    <Button Grid.Column="7" Content="刪除" Padding="10,4" Margin="0,0,4,0" Click="DeleteProfile_Click"/>
                    <Button Grid.Column="8" Content="開啟資料夾" Padding="10,4" Margin="0,0,12,0"
                            ToolTip="開啟設定檔所在資料夾"
                            Click="OpenSettingsFolder_Click"/>

                    <TextBlock Grid.Column="9" Text="Dashboard輪詢ms" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.75"/>
                    <StackPanel Grid.Column="10" Orientation="Horizontal">
                        <TextBox x:Name="TxtDashPollMs" Width="56" Text="800" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="參數輪詢ms" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.75"/>
                        <TextBox x:Name="TxtParamPollMs" Width="56" Text="3000" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Mode + shared Unit ID + actions -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="通訊模式" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.75"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                        <RadioButton x:Name="RbRtu" Content="Modbus RTU (COM)"
                                     IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                     Checked="TransportMode_Changed"/>
                        <RadioButton x:Name="RbTcp" Content="Modbus TCP (Ethernet)"
                                     VerticalAlignment="Center"
                                     Checked="TransportMode_Changed"/>
                    </StackPanel>

                    <TextBlock x:Name="LblUnitId" Grid.Column="2" Text="Slave / Unit ID"
                               VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.75"/>
                    <TextBox x:Name="TxtSlaveId" Grid.Column="3" MaxWidth="80" HorizontalAlignment="Left"
                             Text="1" VerticalContentAlignment="Center" Margin="0,0,12,0"
                             ToolTip="RTU=Slave ID；TCP 經 RS485 閘道時通常仍對應溫控器站號"/>

                    <Button x:Name="BtnConnect" Grid.Column="4"
                            Content="連線" Padding="16,6" Margin="0,0,6,0"
                            Click="Connect_Click"/>
                    <Button x:Name="BtnDisconnect" Grid.Column="5"
                            Content="斷開" Padding="16,6" Margin="0,0,6,0"
                            IsEnabled="False" Click="Disconnect_Click"/>
                    <ToggleButton x:Name="TglPolling" Grid.Column="6"
                                  Content="輪詢 ON" Padding="12,6"
                                  IsEnabled="False" Checked="Polling_Changed" Unchecked="Polling_Changed"/>
                </Grid>

                <!-- RTU settings -->
                <Grid x:Name="PanelRtu" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="COM Port" Margin="0,0,6,4" Opacity="0.75"/>
                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="⟳" ToolTip="重新整理 COM 埠"
                                Padding="8,4" Margin="4,0,0,0" Click="RefreshPorts_Click"/>
                        <ComboBox x:Name="CmbPort" IsEditable="False"/>
                    </DockPanel>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="BaudRate" Margin="0,0,6,4" Opacity="0.75"/>
                    <ComboBox x:Name="CmbBaudRate" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                              SelectedIndex="1">
                        <ComboBoxItem Content="4800"/>
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="57600"/>
                        <ComboBoxItem Content="115200"/>
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Parity" Margin="0,0,6,4" Opacity="0.75"/>
                    <ComboBox x:Name="CmbParity" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Odd"/>
                        <ComboBoxItem Content="Even"/>
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="DataBits" Margin="0,0,6,4" Opacity="0.75"/>
                    <ComboBox x:Name="CmbDataBits" Grid.Row="1" Grid.Column="3" Margin="0,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="7"/>
                    </ComboBox>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="StopBits" Margin="0,0,6,4" Opacity="0.75"/>
                    <ComboBox x:Name="CmbStopBits" Grid.Row="1" Grid.Column="4" SelectedIndex="0">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                    </ComboBox>
                </Grid>

                <!-- TCP settings -->
                <Grid x:Name="PanelTcp" Grid.Row="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP / Host" Margin="0,0,6,4" Opacity="0.75"/>
                    <TextBox x:Name="TxtTcpHost" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                             Text="192.168.1.100" VerticalContentAlignment="Center"
                             ToolTip="RS485 to Ethernet 模組的 IP 位址"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="TCP Port" Margin="0,0,6,4" Opacity="0.75"/>
                    <TextBox x:Name="TxtTcpPort" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                             Text="502" VerticalContentAlignment="Center"
                             ToolTip="預設 502（Modbus TCP）"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="說明" Margin="0,0,6,4" Opacity="0.75"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                               Opacity="0.65" TextWrapping="Wrap"
                               Text="經閘道轉 RS485 時，Unit ID 請設為溫控器站號；串列鮑率請在模組端設定。"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Row 2: Dashboard — 日常操作以 SV / ON-OFF 為主 -->
        <GroupBox Grid.Row="1">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Dashboard 核心監控（日常：SV、ON/OFF）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- PV -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PV (Process Value)" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock x:Name="TxtPv" Grid.Row="1"
                                   Text="—" FontSize="42" FontWeight="Bold"
                                   Foreground="#0B6E4F"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="0x0041 / 40065  ·  Read Only" Opacity="0.55" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- SV -->
                <Border Grid.Column="1" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="SV (Setting Value)" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock x:Name="TxtSvDisplay" Grid.Row="1"
                                   Text="—" FontSize="28" FontWeight="SemiBold"
                                   Foreground="#1B4F72" Margin="0,2,0,6"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSvInput" VerticalContentAlignment="Center"
                                     ToolTip="寫入範圍 -0999 ~ 9999（會依 dP 縮放）"/>
                            <Button Grid.Column="1" Content="讀取" Padding="10,4" Margin="6,0,0,0"
                                    Click="ReadSv_Click"/>
                            <Button Grid.Column="2" Content="寫入" Padding="10,4" Margin="6,0,0,0"
                                    Click="WriteSv_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="0x0023 / 40035  ·  R/W" Opacity="0.55" FontSize="11"
                                   VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Controller ON/OFF -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Controller ON/OFF" FontWeight="SemiBold" Opacity="0.7"
                                   TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                            <ToggleButton x:Name="TglController"
                                          Content="OFF"
                                          Padding="12,10"
                                          HorizontalAlignment="Stretch"
                                          Checked="ControllerToggle_Changed"
                                          Unchecked="ControllerToggle_Changed"/>
                            <TextBlock x:Name="TxtControllerHint" Text="暫存器 0 = ON, 1 = OFF"
                                       Margin="0,8,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="0x0024 / 40036" Opacity="0.55" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Status lamps Out/AL -->
                <Border Grid.Column="3" Style="{StaticResource DashCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Out / Alarm 狀態" FontWeight="SemiBold" Opacity="0.7"/>
                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampOut1" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="Out1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampOut2" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="Out2" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampAl1" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="AL1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampAl2" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="AL2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Grid.Row="2" Text="0x0044 / 40068  ·  Bit0–3" Opacity="0.55" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Alarm error status 0x0048 -->
                <Border Grid.Column="4" Style="{StaticResource DashCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="警報錯誤狀態" FontWeight="SemiBold" Opacity="0.7"/>
                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampErrFff" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="FFF" VerticalAlignment="Center" ToolTip="上限／溢位錯誤"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampErrDash" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="---" VerticalAlignment="Center" ToolTip="下限／欠位錯誤"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampErrHtEr" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="HtEr" VerticalAlignment="Center" ToolTip="Heater Error"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Ellipse x:Name="LampErrOhEr" Style="{StaticResource StatusLamp}"/>
                                <TextBlock Text="OhEr" VerticalAlignment="Center" ToolTip="Output / Overheat Error"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Grid.Row="2" Text="0x0048 / 40072  ·  Bit0–3" Opacity="0.55" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Row 3: Full register map — 3 columns like the manual sheet -->
        <GroupBox Grid.Row="2" Margin="0">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnApplySiteDefaults" DockPanel.Dock="Right"
                            Content="套用站點預設（CT=0, HYS=1, Int=1, H_C=1）"
                            Padding="10,2" Margin="12,0,0,0"
                            ToolTip="寫入很少變動的站點設定；日常請用上方 SV / Controller ON/OFF"
                            Click="ApplySiteDefaults_Click"/>
                    <TextBlock Text="完整暫存器一覽"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox.Header>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#D0D7DE" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="欄 1 · 0x0001–0x000E"
                                   FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                        <DataGrid x:Name="GridCol1" Style="{StaticResource ParamDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexAddress}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTextColumn Header="Dec" Binding="{Binding DecAddress}" IsReadOnly="True" Width="0.7*"/>
                                <DataGridTextColumn Header="代碼 / 說明" Binding="{Binding CodeAndDescription}" IsReadOnly="True" Width="1.7*"/>
                                <DataGridTextColumn Header="數值" Binding="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTemplateColumn Header="寫入" Width="0.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="1" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding CanWrite}"
                                                     ToolTip="{Binding RangeOrOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <Button Content="讀取" Padding="6,1" Margin="0,0,2,0" Tag="{Binding}" Click="ParamRead_Click"/>
                                                <Button Content="寫入" Padding="6,1" Tag="{Binding}" Click="ParamWrite_Click"
                                                        IsEnabled="{Binding CanWrite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="#D0D7DE" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="欄 2 · 0x000F–0x001E（含站點預設）"
                                   FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                        <DataGrid x:Name="GridCol2" Style="{StaticResource ParamDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexAddress}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTextColumn Header="Dec" Binding="{Binding DecAddress}" IsReadOnly="True" Width="0.7*"/>
                                <DataGridTextColumn Header="代碼 / 說明" Binding="{Binding CodeAndDescription}" IsReadOnly="True" Width="1.7*"/>
                                <DataGridTextColumn Header="數值" Binding="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTemplateColumn Header="寫入" Width="0.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="1" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding CanWrite}"
                                                     ToolTip="{Binding RangeOrOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <Button Content="讀取" Padding="6,1" Margin="0,0,2,0" Tag="{Binding}" Click="ParamRead_Click"/>
                                                <Button Content="寫入" Padding="6,1" Tag="{Binding}" Click="ParamWrite_Click"
                                                        IsEnabled="{Binding CanWrite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="欄 3 · 通訊 / SV·PV / 狀態"
                                   FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                        <DataGrid x:Name="GridCol3" Style="{StaticResource ParamDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexAddress}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTextColumn Header="Dec" Binding="{Binding DecAddress}" IsReadOnly="True" Width="0.7*"/>
                                <DataGridTextColumn Header="代碼 / 說明" Binding="{Binding CodeAndDescription}" IsReadOnly="True" Width="1.7*"/>
                                <DataGridTextColumn Header="數值" Binding="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTemplateColumn Header="寫入" Width="0.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="1" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding CanWrite}"
                                                     ToolTip="{Binding RangeOrOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <Button Content="讀取" Padding="6,1" Margin="0,0,2,0" Tag="{Binding}" Click="ParamRead_Click"/>
                                                <Button Content="寫入" Padding="6,1" Tag="{Binding}" Click="ParamWrite_Click"
                                                        IsEnabled="{Binding CanWrite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Row 4: Status bar -->
        <Border Grid.Row="3" Background="#E8EEF4" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtConnectionState" DockPanel.Dock="Left"
                           Text="未連線" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtStatus" Text="就緒。請選擇 COM 埠後連線。" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Row 5: Comm log -->
        <GroupBox Grid.Row="4" Header="通訊診斷 Log" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="清除" Padding="10,4" Margin="0,0,0,6" Click="ClearLog_Click"/>
                    <Button Content="匯出" Padding="10,4" Click="ExportLog_Click"/>
                </StackPanel>
                <ListBox x:Name="LstCommLog" FontFamily="Consolas" FontSize="11"
                         BorderThickness="0" Background="#F8FAFC"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
