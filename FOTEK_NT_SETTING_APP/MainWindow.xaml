<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FOTEK_NT_SETTING_APP.Converters"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="FOTEK_NT_SETTING_APP.MainWindow"
        Title="FOTEK NT Setting — Modbus RTU / TCP"
        MinWidth="1100"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0F1419"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI"
        FontSize="13"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>

        <SolidColorBrush x:Key="BgApp" Color="#0F1419"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1A2230"/>
        <SolidColorBrush x:Key="BgElevated" Color="#222C3C"/>
        <SolidColorBrush x:Key="BgInput" Color="#0B1220"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#334155"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="AccentDim" Color="#0F766E"/>

        <!-- ========== Dark ScrollBar（DataGrid / ListBox / ComboBox 下拉） ========== -->
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#475569"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ScrollButtonFgBrush" Color="#94A3B8"/>

        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumb" Background="{StaticResource ScrollThumbBrush}"
                                CornerRadius="3" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{StaticResource ScrollThumbDragBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarLineButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="bd" Background="{StaticResource ScrollTrackBrush}"
                                BorderBrush="#1A2230" BorderThickness="0">
                            <Path x:Name="arrow" Fill="{StaticResource ScrollButtonFgBrush}"
                                  Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2230"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#222C3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="arrow" Property="Fill" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="{StaticResource ScrollTrackBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition MaxHeight="16"/>
                </Grid.RowDefinitions>
                <RepeatButton Grid.Row="0" Height="16"
                              Style="{StaticResource ScrollBarLineButton}"
                              Command="ScrollBar.LineUpCommand"
                              Content="M 0 4 L 8 4 L 4 0 Z"/>
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton Grid.Row="2" Height="16"
                              Style="{StaticResource ScrollBarLineButton}"
                              Command="ScrollBar.LineDownCommand"
                              Content="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="{StaticResource ScrollTrackBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition MaxWidth="16"/>
                </Grid.ColumnDefinitions>
                <RepeatButton Grid.Column="0" Width="16"
                              Style="{StaticResource ScrollBarLineButton}"
                              Command="ScrollBar.LineLeftCommand"
                              Content="M 4 0 L 4 8 L 0 4 Z"/>
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton Grid.Column="2" Width="16"
                              Style="{StaticResource ScrollBarLineButton}"
                              Command="ScrollBar.LineRightCommand"
                              Content="M 0 0 L 4 4 L 0 8 Z"/>
            </Grid>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- ComboBox：必須自訂 Template，否則系統預設仍是亮底 -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2"
                        Background="#0B1220" BorderBrush="#475569" BorderThickness="1" CornerRadius="3"/>
                <Border Grid.Column="0" Margin="1" Background="Transparent"/>
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#64748B"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2DD4BF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#64748B"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
            <Border x:Name="PART_ContentHost" Focusable="False" Background="{TemplateBinding Background}"/>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#134E4A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Margin="8,3,28,3"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="#E2E8F0"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Template="{StaticResource ComboBoxTextBox}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="6,2,28,2" Focusable="True"
                                     Background="Transparent" Foreground="#E2E8F0" CaretBrush="#E2E8F0"
                                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A2230"
                                            BorderThickness="1" BorderBrush="#475569" CornerRadius="3"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton：自訂 Template，Checked / Enabled 都維持暗色 -->
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="#222C3C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3548"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#134E4A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2DD4BF"/>
                                <Setter Property="Foreground" Value="#99F6E4"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#151C28"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#134E4A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F766E"/>
                                <Setter Property="Foreground" Value="#5EEAD4"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="DashCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource BgElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="StatusLamp" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="#64748B"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ParamDataGrid" TargetType="{x:Type DataGrid}">
            <Style.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#222C3C"/>
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1E3A5F"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="RowBackground" Value="#1A2230"/>
            <Setter Property="AlternatingRowBackground" Value="#151C28"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="#1A2230"/>
                        <Style.Triggers>
                            <!-- 關鍵設定：深藍 -->
                            <DataTrigger Binding="{Binding HighlightLevel}" Value="1">
                                <Setter Property="Background" Value="#1E3A5F"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <!-- 站點預設：暗琥珀 -->
                            <DataTrigger Binding="{Binding HighlightLevel}" Value="2">
                                <Setter Property="Background" Value="#5B3D0F"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3548"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="#042F2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2DD4BF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="#222C3C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3548"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- DataGrid 內「讀取／寫入」等未指定 Style 的按鈕 -->
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BtnGhost}"/>

        <Style x:Key="ModeChip" TargetType="{x:Type RadioButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="chip" Background="#222C3C" BorderBrush="#475569"
                                BorderThickness="1" CornerRadius="3" Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#134E4A"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#2DD4BF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="128"/>
        </Grid.RowDefinitions>

        <!-- Row 1: Flat connection toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Line 1: profile + actions + poll -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="裝置設定檔" Style="{StaticResource InlineLabel}"/>
                        <ComboBox x:Name="CmbProfiles" Width="130" Margin="0,0,8,0"
                                  DisplayMemberPath="ProfileName" SelectionChanged="Profiles_SelectionChanged"/>
                        <TextBlock Text="名稱" Style="{StaticResource InlineLabel}"/>
                        <TextBox x:Name="TxtProfileName" Width="110" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                        <Button Content="套用" Style="{StaticResource BtnGhost}" Margin="0,0,3,0" Click="ApplyProfile_Click"
                                ToolTip="套用選取的設定檔到連線欄位"/>
                        <Button Content="儲存" Style="{StaticResource BtnGhost}" Margin="0,0,3,0" Click="SaveProfile_Click"
                                ToolTip="覆寫目前名稱的設定檔"/>
                        <Button Content="另存" Style="{StaticResource BtnGhost}" Margin="0,0,3,0" Click="SaveProfileAs_Click"/>
                        <Button Content="刪除" Style="{StaticResource BtnGhost}" Margin="0,0,3,0" Click="DeleteProfile_Click"/>
                        <Button Content="開啟資料夾" Style="{StaticResource BtnGhost}" Margin="0,0,14,0" Click="OpenSettingsFolder_Click"
                                ToolTip="開啟 connection-settings.json 所在資料夾"/>
                        <TextBlock Text="Dashboard輪詢" Style="{StaticResource InlineLabel}"/>
                        <TextBox x:Name="TxtDashPollMs" Width="48" Text="800" VerticalContentAlignment="Center" Margin="0,0,2,0"
                                 ToolTip="Dashboard 輪詢間隔（毫秒）"/>
                        <TextBlock Text="ms" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="參數輪詢" Style="{StaticResource InlineLabel}"/>
                        <TextBox x:Name="TxtParamPollMs" Width="48" Text="3000" VerticalContentAlignment="Center" Margin="0,0,2,0"
                                 ToolTip="參數表輪詢間隔（毫秒）"/>
                        <TextBlock Text="ms" Opacity="0.5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtConnHint" Text="確認參數後按連線" Opacity="0.6" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnConnect" Content="連線" Style="{StaticResource BtnPrimary}" Margin="0,0,4,0" Click="Connect_Click"/>
                        <Button x:Name="BtnDisconnect" Content="斷開" Style="{StaticResource BtnSecondary}" Margin="0,0,4,0"
                                IsEnabled="False" Click="Disconnect_Click"/>
                        <ToggleButton x:Name="TglPolling" Content="輪詢：關閉" Padding="10,3" IsEnabled="False"
                                      Checked="Polling_Changed" Unchecked="Polling_Changed"/>
                    </StackPanel>
                </DockPanel>

                <!-- Line 2: mode + transport params -->
                <DockPanel Grid.Row="1" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <RadioButton x:Name="RbRtu" Content="Modbus RTU" Style="{StaticResource ModeChip}" IsChecked="True"
                                     Checked="TransportMode_Changed" ToolTip="序列埠 COM 直連"/>
                        <RadioButton x:Name="RbTcp" Content="Modbus TCP" Style="{StaticResource ModeChip}"
                                     Checked="TransportMode_Changed" ToolTip="Ethernet / RS485 閘道"/>
                        <TextBlock x:Name="LblUnitId" Text="Slave ID" Style="{StaticResource InlineLabel}" Margin="6,0,4,0"/>
                        <TextBox x:Name="TxtSlaveId" Width="48" Text="1" VerticalContentAlignment="Center"
                                 ToolTip="RTU=Slave ID；TCP 閘道時通常對應溫控器站號"/>
                    </StackPanel>

                    <Grid x:Name="PanelRtu" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.75*"/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="COM Port" Style="{StaticResource InlineLabel}"/>
                            <Button DockPanel.Dock="Right" Content="重新整理" Style="{StaticResource BtnGhost}" Margin="4,0,0,0"
                                    Click="RefreshPorts_Click" ToolTip="重新掃描 COM 埠"/>
                            <ComboBox x:Name="CmbPort" IsEditable="False"/>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Baud Rate" Style="{StaticResource InlineLabel}"/>
                            <ComboBox x:Name="CmbBaudRate" SelectedIndex="1">
                                <ComboBoxItem Content="4800"/>
                                <ComboBoxItem Content="9600"/>
                                <ComboBoxItem Content="19200"/>
                                <ComboBoxItem Content="38400"/>
                                <ComboBoxItem Content="57600"/>
                                <ComboBoxItem Content="115200"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Grid.Column="2" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Parity" Style="{StaticResource InlineLabel}"/>
                            <ComboBox x:Name="CmbParity" SelectedIndex="0">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Odd"/>
                                <ComboBoxItem Content="Even"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Grid.Column="3" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Data Bits" Style="{StaticResource InlineLabel}"/>
                            <ComboBox x:Name="CmbDataBits" SelectedIndex="0">
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="7"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Grid.Column="4" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Stop Bits" Style="{StaticResource InlineLabel}"/>
                            <ComboBox x:Name="CmbStopBits" SelectedIndex="0">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                            </ComboBox>
                        </DockPanel>
                    </Grid>

                    <Grid x:Name="PanelTcp" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="IP / Host" Style="{StaticResource InlineLabel}"/>
                            <TextBox x:Name="TxtTcpHost" Text="192.168.1.100" VerticalContentAlignment="Center"
                                     ToolTip="RS485 to Ethernet 模組 IP"/>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="TCP Port" Style="{StaticResource InlineLabel}"/>
                            <TextBox x:Name="TxtTcpPort" Text="502" VerticalContentAlignment="Center"
                                     ToolTip="預設 502"/>
                        </DockPanel>
                        <TextBlock Grid.Column="2" Text="閘道轉 RS485：Unit ID = 溫控器站號；鮑率在模組端設定"
                                   Opacity="0.6" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Row 2: Dashboard — flat but readable -->
        <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <!-- PV -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PV · 目前溫度" FontWeight="SemiBold" Opacity="0.7" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtPv" Text="—" FontSize="28" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Text="  0x0041 / 40065  RO" Opacity="0.45" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SV -->
                <Border Grid.Column="1" Style="{StaticResource DashCard}">
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock Text="SV · 設定溫度" FontWeight="SemiBold" Opacity="0.7" FontSize="11"/>
                            <TextBlock DockPanel.Dock="Right" Text="0x0023 / 40035" Opacity="0.45" FontSize="10" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0" LastChildFill="True">
                            <TextBlock x:Name="TxtSvDisplay" DockPanel.Dock="Left" Text="—" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="52"/>
                            <Button DockPanel.Dock="Right" Content="寫入" Style="{StaticResource BtnGhost}" Margin="4,0,0,0" Click="WriteSv_Click"/>
                            <Button DockPanel.Dock="Right" Content="讀取" Style="{StaticResource BtnGhost}" Click="ReadSv_Click"/>
                            <TextBox x:Name="TxtSvInput" VerticalContentAlignment="Center" Margin="0,0,4,0"
                                     ToolTip="寫入範圍 -0999 ~ 9999（依 dP 縮放）"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ON/OFF -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Controller ON/OFF" FontWeight="SemiBold" Opacity="0.7" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ToggleButton x:Name="TglController" Content="OFF" Padding="12,4" Margin="0,0,8,0"
                                          Checked="ControllerToggle_Changed" Unchecked="ControllerToggle_Changed"
                                          ToolTip="0=ON（可控制輸出）, 1=OFF"/>
                            <TextBlock Text="0=ON / 1=OFF" Opacity="0.5" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Out / AL -->
                <Border Grid.Column="3" Style="{StaticResource DashCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Out / Alarm 狀態 · 0x0044" FontWeight="SemiBold" Opacity="0.7" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="LampOut1" Style="{StaticResource StatusLamp}"/>
                            <TextBlock Text="Out1" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse x:Name="LampOut2" Style="{StaticResource StatusLamp}"/>
                            <TextBlock Text="Out2" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse x:Name="LampAl1" Style="{StaticResource StatusLamp}"/>
                            <TextBlock Text="AL1" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse x:Name="LampAl2" Style="{StaticResource StatusLamp}"/>
                            <TextBlock Text="AL2" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error status -->
                <Border Grid.Column="4" Style="{StaticResource DashCard}" Margin="0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="警報錯誤 · 0x0048" FontWeight="SemiBold" Opacity="0.7" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="LampErrFff" Style="{StaticResource StatusLamp}" ToolTip="上限／溢位"/>
                            <TextBlock Text="FFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Ellipse x:Name="LampErrDash" Style="{StaticResource StatusLamp}" ToolTip="下限／欠位"/>
                            <TextBlock Text="---" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Ellipse x:Name="LampErrHtEr" Style="{StaticResource StatusLamp}" ToolTip="Heater Error"/>
                            <TextBlock Text="HtEr" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Ellipse x:Name="LampErrOhEr" Style="{StaticResource StatusLamp}" ToolTip="Overheat / Output Error"/>
                            <TextBlock Text="OhEr" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 3: Full register map — 3 columns like the manual sheet -->
        <GroupBox Grid.Row="2" Margin="0">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnApplySiteDefaults" DockPanel.Dock="Right"
                            Content="套用站點預設（CT=0, HYS=1, Int=1, H_C=1）"
                            Padding="10,2" Margin="12,0,0,0"
                            ToolTip="寫入很少變動的站點設定；日常請用上方 SV / Controller ON/OFF"
                            Click="ApplySiteDefaults_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="完整暫存器一覽" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border Background="#5B3D0F" CornerRadius="3" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="站點預設" FontSize="11" Foreground="#FDE68A"/>
                        </Border>
                        <Border Background="#1E3A5F" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="關鍵設定" FontSize="11" Foreground="#BFDBFE"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </GroupBox.Header>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="欄 1 · 0x0001–0x000E"
                                   FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                        <DataGrid x:Name="GridCol1" Style="{StaticResource ParamDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexAddress}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTextColumn Header="Dec" Binding="{Binding DecAddress}" IsReadOnly="True" Width="0.7*"/>
                                <DataGridTextColumn Header="代碼 / 說明" Binding="{Binding CodeAndDescription}" IsReadOnly="True" Width="1.7*"/>
                                <DataGridTextColumn Header="數值" Binding="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTemplateColumn Header="寫入" Width="0.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="1" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding CanWrite}"
                                                     ToolTip="{Binding RangeOrOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <Button Content="讀取" Padding="6,1" Margin="0,0,2,0" Tag="{Binding}" Click="ParamRead_Click"/>
                                                <Button Content="寫入" Padding="6,1" Tag="{Binding}" Click="ParamWrite_Click"
                                                        IsEnabled="{Binding CanWrite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="0,0,6,0" Margin="0,0,6,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="欄 2 · 0x000F–0x001E（含站點預設）"
                                   FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                        <DataGrid x:Name="GridCol2" Style="{StaticResource ParamDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexAddress}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTextColumn Header="Dec" Binding="{Binding DecAddress}" IsReadOnly="True" Width="0.7*"/>
                                <DataGridTextColumn Header="代碼 / 說明" Binding="{Binding CodeAndDescription}" IsReadOnly="True" Width="1.7*"/>
                                <DataGridTextColumn Header="數值" Binding="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTemplateColumn Header="寫入" Width="0.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="1" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding CanWrite}"
                                                     ToolTip="{Binding RangeOrOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <Button Content="讀取" Padding="6,1" Margin="0,0,2,0" Tag="{Binding}" Click="ParamRead_Click"/>
                                                <Button Content="寫入" Padding="6,1" Tag="{Binding}" Click="ParamWrite_Click"
                                                        IsEnabled="{Binding CanWrite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="欄 3 · 通訊 / SV·PV / 狀態"
                                   FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,4"/>
                        <DataGrid x:Name="GridCol3" Style="{StaticResource ParamDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hex" Binding="{Binding HexAddress}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTextColumn Header="Dec" Binding="{Binding DecAddress}" IsReadOnly="True" Width="0.7*"/>
                                <DataGridTextColumn Header="代碼 / 說明" Binding="{Binding CodeAndDescription}" IsReadOnly="True" Width="1.7*"/>
                                <DataGridTextColumn Header="數值" Binding="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" Width="0.85*"/>
                                <DataGridTemplateColumn Header="寫入" Width="0.7*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="1" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding CanWrite}"
                                                     ToolTip="{Binding RangeOrOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="1.35*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1">
                                                <Button Content="讀取" Padding="6,1" Margin="0,0,2,0" Tag="{Binding}" Click="ParamRead_Click"/>
                                                <Button Content="寫入" Padding="6,1" Tag="{Binding}" Click="ParamWrite_Click"
                                                        IsEnabled="{Binding CanWrite}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Row 4: Status bar -->
        <Border Grid.Row="3" Background="#0B1220" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="3" Padding="8,4" Margin="0,4,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtConnectionState" DockPanel.Dock="Left"
                           Text="未連線" FontWeight="SemiBold" Margin="0,0,12,0" FontSize="12"
                           Foreground="#94A3B8"/>
                <TextBlock x:Name="TxtStatus" Text="就緒。" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           FontSize="12" Foreground="#CBD5E1"/>
            </DockPanel>
        </Border>

        <!-- Row 5: Log (~5 lines) -->
        <Border Grid.Row="4" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="3" Margin="0,4,0,0" Padding="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Button Content="清除" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="ClearLog_Click"/>
                    <Button Content="匯出" Style="{StaticResource BtnGhost}" Click="ExportLog_Click"/>
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="通訊 Log" FontSize="11" Foreground="#94A3B8" Margin="2,0,0,2"/>
                    <ListBox x:Name="LstCommLog" FontFamily="Consolas" FontSize="11"
                             BorderThickness="0" Background="#0B1220" Foreground="#E2E8F0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A5F"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A2230"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Foreground="#E2E8F0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
